{
  "expo": {
    "name": "AssetBridge",
    "slug": "assetbridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "assetbridge",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.assetbridge.app",
      "infoPlist": {
        "NSCameraUsageDescription": "AssetBridge requires camera access to photograph and verify collectibles and scan QR certificates.",
        "NSPhotoLibraryUsageDescription": "Allow AssetBridge to access your photos for asset verification and provenance upload.",
        "NSPhotoLibraryAddUsageDescription": "Allow AssetBridge to save certificates and receipts.",
        "NSMicrophoneUsageDescription": "Allow AssetBridge to use your microphone",
        "LSApplicationQueriesSchemes": [
          "metamask",
          "assetbridge"
        ]
      }
    },
    "android": {
      "package": "com.assetbridge.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "assetbridge"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AssetBridge camera access to photograph items and scan QR certificates.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "45e8dce4-f9e6-4de7-b898-137fdc0905eb"
      }
    }
  }
}
